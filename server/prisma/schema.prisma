datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  head        String?
  description String?
  budget      Float?        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employees   Employee[]
  designations Designation[]
  jobPostings JobPosting[]
}

model Designation {
  id           Int         @id @default(autoincrement())
  departmentId Int
  title        String
  level        String?
  minSalary    Float?
  maxSalary    Float?
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Branch {
  id           Int         @id @default(autoincrement())
  name         String
  city         String
  address      String?
  phone        String?
  email        String?
  isHeadOffice Boolean     @default(false)
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Shift {
  id           Int         @id @default(autoincrement())
  name         String
  startTime    String      // HH:mm
  endTime      String      // HH:mm
  graceMinutes Int         @default(15)
  workingHours Float       @default(8)
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Employee {
  id               Int                 @id @default(autoincrement())
  empNo            String              @unique
  firstName        String
  lastName         String
  fullName         String
  email            String              @unique
  phone            String?
  cnic             String?
  dob              String?
  gender           String?
  maritalStatus    String?
  address          String?
  departmentId     Int?
  designationId    Int?
  branchId         Int?
  shiftId          Int?
  joiningDate      String
  confirmationDate String?
  employmentType   String              @default("Permanent") // Permanent, Contract, Probation, Intern
  status           String              @default("active")    // active, inactive, terminated, on_leave
  role             String              @default("employee")  // superadmin, hr_manager, dept_manager, employee, onboarding
  onboardingStatus String?
  salary           Float               @default(0)
  photo            String?
  managerId        Int?
  bloodGroup       String?
  nationality      String?             @default("Pakistani")
  religion         String?
  bankName         String?
  accountNo        String?
  iban             String?
  emergencyContact String?             // JSON string
  qualifications   String?             // JSON string
  experience       String?             // JSON string
  
  department       Department?         @relation(fields: [departmentId], references: [id])
  designation      Designation?        @relation(fields: [designationId], references: [id])
  branch           Branch?             @relation(fields: [branchId], references: [id])
  shift            Shift?              @relation(fields: [shiftId], references: [id])
  user             User?
  attendances          Attendance[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  payrolls             Payroll[]
  reviewsReceived      PerformanceReview[]   @relation("Reviewee")
  reviewsGiven         PerformanceReview[]   @relation("Reviewer")
  educations           Education[]
  workExperiences      WorkExperience[]
  emergencyContacts    EmergencyContact[]
  skills               Skill[]
  certificates         Certificate[]
  disciplinaryActions  DisciplinaryAction[]
  warningLetters       WarningLetter[]
  suspensions          Suspension[]
  terminations         TerminationRecord[]
  trainingAttendees    TrainingAttendee[]
  trainingCertificates TrainingCertificate[]
  trainingFeedbacks    TrainingFeedback[]
  travelRequests       TravelRequest[]
  expenseClaims        ExpenseClaim[]
  salaries             EmployeeSalary[]
  salaryReviews        SalaryReview[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String    // Hashed with bcrypt
  role        String    @default("employee")
  employeeId  Int       @unique
  status      String    @default("active")
  lastLogin   DateTime?
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  userPermissions UserPermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  date          String    // YYYY-MM-DD
  checkIn       String?   // HH:mm
  checkOut      String?   // HH:mm
  status        String    @default("present") // present, late, absent, half_day, leave, holiday
  workHours     Float     @default(0)
  overtimeHours Float     @default(0)
  lateMinutes   Int       @default(0)
  notes         String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, date])
}

model LeaveType {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  daysAllowed   Int            @default(14)
  isPaid        Boolean        @default(true)
  carryForward  Boolean        @default(false)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model LeaveBalance {
  id          Int        @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int        @default(2026)
  total       Float      @default(14)
  used        Float      @default(0)
  pending     Float      @default(0)
  available   Float      @default(14)
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  leaveTypeId     Int
  startDate       String    // YYYY-MM-DD
  endDate         String    // YYYY-MM-DD
  days            Float     @default(1)
  reason          String
  status          String    @default("pending") // pending, approved, rejected, cancelled
  appliedOn       DateTime  @default(now())
  approvedBy      Int?
  approvedOn      DateTime?
  rejectionReason String?
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Payroll {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  month         Int       // 1-12
  year          Int       // e.g. 2026
  baseSalary    Float
  allowances    String?   // JSON string of allowance objects
  deductions    String?   // JSON string of deduction objects
  grossSalary   Float
  netSalary     Float
  tax           Float     @default(0)
  paymentStatus String    @default("pending") // pending, paid, on_hold
  paymentDate   String?
  paymentMethod String?          @default("Bank Transfer")
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  slipItems     SalarySlipItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, month, year])
}

model PerformanceReview {
  id         Int       @id @default(autoincrement())
  employeeId Int
  reviewerId Int
  period     String    // e.g., "Q3 2026", "Annual 2026"
  year       Int       @default(2026)
  rating     Float     @default(0)
  feedback   String?
  goals      String?   // JSON string
  status     String    @default("completed") // draft, pending_review, completed
  employee   Employee  @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee  @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model JobPosting {
  id           Int         @id @default(autoincrement())
  title        String
  departmentId Int
  location     String?
  type         String      @default("Full-time")
  experience   String?
  positions    Int         @default(1)
  status       String      @default("active") // active, closed, draft
  postedDate   String
  closingDate  String?
  description  String?
  requirements String?
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  candidates   Candidate[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Candidate {
  id          Int        @id @default(autoincrement())
  jobId       Int
  fullName    String
  email       String
  phone       String?
  stage       String     @default("applied") // applied, screening, interview, offered, hired, rejected
  rating      Float?     @default(0)
  appliedDate String
  resumeUrl   String?
  notes       String?
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CompanyEvent {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   // meeting, training, holiday, social
  startDate   String
  endDate     String?
  location    String?
  description String?
  organizerId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  priority   String   @default("normal") // normal, high, urgent
  targetRole String   @default("all")
  postedDate String
  authorId   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Holiday {
  id         Int      @id @default(autoincrement())
  title      String
  date       String   // YYYY-MM-DD
  year       Int      @default(2026)
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   // LOGIN, CREATE, UPDATE, DELETE, LOGOUT
  module      String   // Auth, Employees, Payroll, Attendance, Leaves, System
  description String
  userId      Int?
  ipAddress   String?
  timestamp   DateTime @default(now())
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── DISCIPLINE & LEGAL COMPLIANCE (5 Models) ──────────────────

model DisciplinaryType {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique // ABSENT, MISCONDUCT, INSUBORDINATION, BREACH, HARASSMENT, NEGLIGENCE
  name                String
  severity            String               @default("medium") // low, medium, high, critical
  description         String?
  actions             DisciplinaryAction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model DisciplinaryAction {
  id                  Int                  @id @default(autoincrement())
  caseNumber          String               @unique // e.g. DIS-2026-001
  employeeId          Int
  typeId              Int
  title               String
  reportedBy          String
  incidentDate        String               // YYYY-MM-DD
  hearingDate         String?              // YYYY-MM-DD
  committeeMembers    String?              // comma-separated or JSON
  allegationDetails   String
  findings            String?
  status              String               @default("under_investigation") // under_investigation, hearing_scheduled, resolved, dismissed
  outcome             String?              // warning, suspension, termination, exonerated
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  disciplinaryType    DisciplinaryType     @relation(fields: [typeId], references: [id])
  warningLetters      WarningLetter[]
  suspensions         Suspension[]
  terminations        TerminationRecord[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WarningLetter {
  id                  Int                  @id @default(autoincrement())
  refNo               String               @unique // e.g. WRN/2026/004
  actionId            Int?
  employeeId          Int
  warningLevel        String               // show_cause, first_written, second_written, final_warning
  title               String
  subject             String
  details             String
  penaltyDetails      String?
  issuedDate          String               // YYYY-MM-DD
  issuedBy            String
  acknowledged        Boolean              @default(false)
  acknowledgedAt      DateTime?
  employeeRemarks     String?
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  disciplinaryAction  DisciplinaryAction?  @relation(fields: [actionId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Suspension {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  actionId            Int?
  startDate           String               // YYYY-MM-DD
  endDate             String               // YYYY-MM-DD
  isWithPay           Boolean              @default(false)
  reason              String
  approvedBy          String
  status              String               @default("active") // active, revoked, completed
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  disciplinaryAction  DisciplinaryAction?  @relation(fields: [actionId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model TerminationRecord {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  actionId            Int?
  terminationDate     String               // YYYY-MM-DD
  terminationType     String               // with_cause, summary_dismissal, performance
  legalGrounds        String
  severancePayable    Float                @default(0)
  noticePeriodWaived  Boolean              @default(false)
  approvedBy          String
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  disciplinaryAction  DisciplinaryAction?  @relation(fields: [actionId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// ─── RELATIONAL EMPLOYEE PROFILE (5 Models) ────────────────────

model Education {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  degree              String               // BS, MS, PhD, Matric, Intermediate, Diploma
  fieldOfStudy        String?              // Computer Science, Software Engineering, etc.
  institution         String               // University / Board
  passingYear         Int
  grade               String?              // A+, 3.8 GPA, 1st Division
  verificationStatus  String               @default("verified") // pending, verified, rejected
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WorkExperience {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  company             String
  designation         String
  startDate           String               // YYYY-MM-DD
  endDate             String?              // YYYY-MM-DD (null for current)
  responsibilities    String?
  leavingReason       String?
  referenceContact    String?
  verificationStatus  String               @default("verified")
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model EmergencyContact {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  name                String
  relationship        String               // Spouse, Father, Mother, Brother, Sister, Guardian
  primaryPhone        String
  secondaryPhone      String?
  address             String?
  isPrimary           Boolean              @default(true)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Skill {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  name                String               // JavaScript, Node.js, Financial Modeling, HR Auditing
  category            String               @default("technical") // technical, management, soft_skill, language
  proficiency         String               @default("Intermediate") // Beginner, Intermediate, Advanced, Expert
  yearsOfExperience   Float?               @default(1.0)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Certificate {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  title               String               // PMP, AWS Certified, ACCA, Cisco CCNA
  issuingBody         String               // Project Management Institute, Amazon, etc.
  issueDate           String               // YYYY-MM-DD
  expiryDate          String?              // YYYY-MM-DD
  credentialId        String?
  credentialUrl       String?
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// ─── TRAINING & LMS (4 Models) ─────────────────────────────────

model TrainingSession {
  id                  Int                  @id @default(autoincrement())
  sessionCode         String               @unique // TRN-SES-2026-001
  title               String
  category            String               // Technical, Compliance, Leadership, Safety
  trainerName         String
  venueOrUrl          String               // Karachi Training Hall / Zoom meeting URL
  startDate           String               // YYYY-MM-DD
  endDate             String               // YYYY-MM-DD
  durationHours       Float                @default(4)
  cpdCredits          Int                  @default(2)
  maxCapacity         Int                  @default(30)
  status              String               @default("scheduled") // scheduled, in_progress, completed, cancelled
  attendees           TrainingAttendee[]
  certificates        TrainingCertificate[]
  feedbacks           TrainingFeedback[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model TrainingAttendee {
  id                  Int                  @id @default(autoincrement())
  sessionId           Int
  employeeId          Int
  attendanceStatus    String               @default("registered") // registered, attended, completed, absent
  preAssessmentScore  Float?               @default(0)
  postAssessmentScore Float?               @default(0)
  session             TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sessionId, employeeId])
}

model TrainingCertificate {
  id                  Int                  @id @default(autoincrement())
  certificateNo       String               @unique // CPD-2026-98124
  sessionId           Int
  employeeId          Int
  title               String
  issuedDate          String               // YYYY-MM-DD
  validityYears       Int                  @default(2)
  verificationHash    String               // Cryptographic SHA-256 validation stamp
  cpdCredits          Int                  @default(2)
  session             TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model TrainingFeedback {
  id                  Int                  @id @default(autoincrement())
  sessionId           Int
  employeeId          Int
  rating              Int                  @default(5) // 1 to 5
  trainerRating       Int                  @default(5)
  contentRelevance    Int                  @default(5)
  comments            String?
  session             TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sessionId, employeeId])
}

// ==========================================
// PHASE 2: TRAVEL & EXPENSE REQUISITIONS (6 Models)
// ==========================================

model ExpenseCategory {
  id              Int             @id @default(autoincrement())
  name            String
  code            String          @unique
  maxDailyLimit   Float?          @default(0)
  requiresReceipt Boolean         @default(true)
  isPerDiem       Boolean         @default(false)
  description     String?
  travelExpenses  TravelExpense[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TravelRequest {
  id                 Int              @id @default(autoincrement())
  requestNo          String           @unique // TRV-2026-001
  employeeId         Int
  purpose            String
  travelType         String           @default("domestic") // domestic, international
  departureDate      String           // YYYY-MM-DD
  returnDate         String           // YYYY-MM-DD
  originCity         String
  destinationCity    String
  destinationCountry String           @default("Pakistan")
  travelMode         String           @default("Flight") // Flight, Train, Company Car, Personal Vehicle
  estimatedBudget    Float            @default(0)
  advanceAmount      Float            @default(0)
  advanceStatus      String           @default("none") // none, requested, approved, disbursed
  status             String           @default("pending") // pending, approved, rejected, completed, cancelled
  approvedBy         Int?
  approvedAt         DateTime?
  notes              String?
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenses           TravelExpense[]
  approvals          TravelApproval[]
  claims             ExpenseClaim[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TravelExpense {
  id              Int             @id @default(autoincrement())
  travelRequestId Int
  categoryId      Int
  expenseDate     String          // YYYY-MM-DD
  title           String
  amount          Float
  currency        String          @default("PKR")
  merchant        String?
  receiptUrl      String?
  receiptNo       String?
  isBillable      Boolean         @default(false)
  status          String          @default("pending") // pending, approved, rejected
  travelRequest   TravelRequest   @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TravelApproval {
  id              Int           @id @default(autoincrement())
  travelRequestId Int
  approverId      Int
  step            String        @default("manager") // manager, finance, director
  status          String        // approved, rejected
  comments        String?
  actionAt        DateTime      @default(now())
  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
}

model ExpenseClaim {
  id              Int                @id @default(autoincrement())
  claimNo         String             @unique // CLM-2026-001
  employeeId      Int
  travelRequestId Int?
  title           String
  totalAmount     Float
  approvedAmount  Float?
  status          String             @default("submitted") // submitted, approved, reimbursed, rejected
  submittedDate   String             // YYYY-MM-DD
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  travelRequest   TravelRequest?     @relation(fields: [travelRequestId], references: [id])
  settlement      ExpenseSettlement?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ExpenseSettlement {
  id               Int          @id @default(autoincrement())
  claimId          Int          @unique
  settlementRef    String       @unique // SET-2026-001
  settlementMethod String       @default("Payroll") // Payroll, Bank Transfer, Petty Cash
  payoutAmount     Float
  disbursementDate String       // YYYY-MM-DD
  financeOfficerId Int?
  claim            ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ==========================================
// PHASE 2: GOVERNANCE & DYNAMIC RBAC (6 Models)
// ==========================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  code        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  priority    Int              @default(1)
  permissions RolePermission[]
  userRoles   UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SystemModule {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  category    String?
  icon        String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  moduleId        Int
  action          String           // view, create, edit, delete, approve, export
  description     String?
  module          SystemModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  isGranted    Boolean    @default(true)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermission {
  id             Int        @id @default(autoincrement())
  userId         Int
  permissionId   Int
  isGranted      Boolean    @default(true)
  overrideReason String?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, permissionId])
}

// ==========================================
// PHASE 2: COMPENSATION & SALARY STRUCTURE (5 Models)
// ==========================================

model SalaryStructure {
  id                   Int              @id @default(autoincrement())
  name                 String
  code                 String           @unique
  description          String?
  basePercentage       Float            @default(50.0)
  hraPercentage        Float            @default(25.0)
  medicalPercentage    Float            @default(15.0)
  conveyancePercentage Float            @default(10.0)
  isActive             Boolean          @default(true)
  employeeSalaries     EmployeeSalary[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model SalaryComponent {
  id              Int              @id @default(autoincrement())
  name            String
  code            String           @unique
  type            String           // earning, deduction
  calculationType String           @default("fixed") // fixed, percentage
  isTaxable       Boolean          @default(true)
  isStatutory     Boolean          @default(false)
  defaultValue    Float            @default(0)
  slipItems       SalarySlipItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model EmployeeSalary {
  id            Int             @id @default(autoincrement())
  employeeId    Int
  structureId   Int
  basicSalary   Float
  grossSalary   Float
  currency      String          @default("PKR")
  effectiveDate String          // YYYY-MM-DD
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model SalarySlipItem {
  id          Int              @id @default(autoincrement())
  payrollId   Int
  componentId Int?
  name        String
  type        String           // earning, deduction
  amount      Float
  payroll     Payroll          @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  component   SalaryComponent? @relation(fields: [componentId], references: [id])
  createdAt   DateTime         @default(now())
}

model SalaryReview {
  id                  Int      @id @default(autoincrement())
  employeeId          Int
  oldGross            Float
  newGross            Float
  incrementPercentage Float
  reviewDate          String   // YYYY-MM-DD
  effectiveDate       String   // YYYY-MM-DD
  approvedBy          Int?
  remarks             String?
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

