# ═══════════════════════════════════════════════════════════════════
# HRM PRO ENTERPRISE — PRODUCTION CLOUD ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Node Environment & Port
NODE_ENV=production
PORT=5000

# Security & Session Secrets
JWT_SECRET="hrm-pro-super-secret-jwt-key-2026-production"
CRON_SECRET="hrm-cron-secret-token-2026"

# Database Connections (PostgreSQL on Vercel Postgres, Supabase, or Render)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true"
POSTGRES_PRISMA_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Supabase Cloud REST API & Realtime Sync
SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SMTP Email Configuration (Gmail, SendGrid, Amazon SES, or Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@yourcompany.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="HRM Pro Enterprise <notifications@yourcompany.com>"
