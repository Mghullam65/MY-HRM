{
  "name": "my-hrm",
  "version": "1.0.0",
  "private": true,
  "description": "HRM Pro — Cloud Human Resource Management System",
  "scripts": {
    "build": "prisma generate --schema=server/prisma/schema.prisma && prisma db push --schema=server/prisma/schema.prisma --accept-data-loss",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=server/prisma/schema.prisma --accept-data-loss",
    "seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
